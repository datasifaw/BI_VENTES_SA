	column 'Nombre Commandes Client' =
			
			CALCULATE (
			    DISTINCTCOUNT ( Commande[CommandeId] )
			)
		formatString: 0
		lineageTag: 5bf3ed9d-375b-49b4-ae4e-f91cd364c5bc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Typologie Client' =
			
			VAR NbCommandes = Client[Nombre Commandes Client]
			RETURN
			    SWITCH (
			        TRUE (),
			        NbCommandes <= 10, "CLIENT OCCASIONNEL",
			        NbCommandes <= 20, "CLIENT FREQUENT",
			        NbCommandes <= 30, "CLIENT FIDEL",
			        "SUPER CLIENT"
			    )
		lineageTag: caa69639-400e-4cd7-a1ac-3aec35babd47
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

