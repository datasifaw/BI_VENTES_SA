	column Transport
		dataType: decimal
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 672f9aba-01f5-4d3e-a2f4-236a14395ffb
		summarizeBy: sum
		sourceColumn: Transport

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"fr-FR"}

	column 'Délai Expédition' =
			
			IF (
			    NOT ISBLANK ( Commande[DateExpedition] ),
			    DATEDIFF (
			        Commande[DateCommande],
			        Commande[DateExpedition],
			        DAY
			    )
			)
		formatString: 0
		lineageTag: 4df9a174-fdfd-4cbf-a0a2-ad5cb84bffdb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Statut Expédition' =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( Commande[DateExpedition] ), "Non expédiée",
			    Commande[DateExpedition] <= Commande[DateDemandee], "À temps",
			    "En retard"
			)
		lineageTag: dfe7bc19-0593-43c4-bfcf-3ea5f280ec2d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Commande = m
		mode: import
		queryGroup: Faits
		source =
				let
				    Source = Sql.Databases(".\SQLEXPRESS"),
				    Ventes = Source{[Name="Ventes"]}[Data],
				    dbo_Commande = Ventes{[Schema="dbo",Item="Commande"]}[Data]
				in
				    dbo_Commande

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

