	column Année-Trimestre =
			
			FORMAT ( Calendrier[Date], "yyyy" )
			    & "-T"
			    & FORMAT ( Calendrier[Date], "Q" )
		lineageTag: 5cbaa619-a5c5-4071-ae78-d47f153fa93f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Calendrier = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR (
				        MIN ( Commande[DateCommande] ),
				        MAX ( Commande[DateCommande] )
				    ),
				    "Année", YEAR ( [Date] ),
				    "Mois N°", MONTH ( [Date] ),
				    "Nom du mois", FORMAT ( [Date], "mmmm" ),
				    "Mois Court", FORMAT ( [Date], "mmm" ),
				    "Trimestre", "T" & FORMAT ( [Date], "Q" ),
				    "Jour", DAY ( [Date] ),
				    "Jour Semaine", FORMAT ( [Date], "dddd" ),
				    "Num Jour Semaine", WEEKDAY ( [Date], 2 ),
				    "Année-Mois", FORMAT([Date], "yyyy-MM")
				)

	annotation PBI_Id = 1a98253011014c849ae0299b215e85f9

